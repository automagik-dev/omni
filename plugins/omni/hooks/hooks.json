{
  "description": "Omni plugin hooks — auto-install CLI on setup, health check on session start",
  "hooks": {
    "Setup": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/omni-runner.js\" setup",
            "timeout": 300
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/omni-runner.js\" health",
            "timeout": 45
          }
        ]
      }
    ]
  }
}
