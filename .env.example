# =============================================================================
# Omni v2 Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values as needed
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:8432/omni

# Set to true to run pgserve embedded inside the API process (recommended)
# Set to false to use an external PostgreSQL server instead
PGSERVE_EMBEDDED=true
PGSERVE_PORT=8432
PGSERVE_DATA=./.pgserve-data

# -----------------------------------------------------------------------------
# NATS (Event Bus)
# -----------------------------------------------------------------------------
NATS_URL=nats://localhost:4222

# Set to true to have PM2 manage nats-server (local dev)
NATS_MANAGED=true
NATS_PORT=4222

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
API_PORT=8882
API_HOST=0.0.0.0

# Set to true to have PM2 manage the API server (local dev)
API_MANAGED=true

# -----------------------------------------------------------------------------
# Sentry (Error Tracking & Performance Monitoring)
# DSN is hardcoded to the Omni project — override to redirect, set empty to disable
# -----------------------------------------------------------------------------
# SENTRY_DSN=                        # Set empty string to disable Sentry
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_ENVIRONMENT=development

# -----------------------------------------------------------------------------
# Secrets (add as needed)
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# WhatsApp outbound timing
# -----------------------------------------------------------------------------
# Humanized delay before outgoing WhatsApp actions. Set ENABLED=false to disable.
# WHATSAPP_HUMAN_DELAY_ENABLED=true
# WHATSAPP_HUMAN_DELAY_MIN_MS=1500
# WHATSAPP_HUMAN_DELAY_MAX_MS=3500

# Typing simulation before text/caption sends. Set ENABLED=false to disable.
# Delay is min(BASE_MS + text.length * PER_CHAR_MS, MAX_MS).
# WHATSAPP_TYPING_SIMULATION_ENABLED=true
# WHATSAPP_TYPING_DELAY_BASE_MS=800
# WHATSAPP_TYPING_DELAY_PER_CHAR_MS=30
# WHATSAPP_TYPING_DELAY_MAX_MS=4000
# WHATSAPP_TYPING_DEFAULT_MS=3000

# Exponential backoff used after WhatsApp/Baileys rate-limit errors.
# WHATSAPP_RATE_LIMIT_INITIAL_BACKOFF_MS=1000
# WHATSAPP_RATE_LIMIT_MAX_BACKOFF_MS=30000
# WHATSAPP_RATE_LIMIT_JITTER_FACTOR=0.2

# -----------------------------------------------------------------------------
# Microsoft Teams (Bot Framework)
# -----------------------------------------------------------------------------
# Per-tenant credentials live on `InstanceConfig` (one bot per tenant). The
# vars below are global runtime defaults the plugin reads when an instance does
# not override them. See docs/channel-parity/teams.md for the full setup walk-through.
#
# Webhook ingress: the plugin handler is mounted at
# `POST /api/v2/channels/teams/:instanceId/webhook` (mirrors the gupshup +
# twilio-whatsapp + telegram pattern). Point your Bot Framework messaging
# endpoint at `${WEBHOOK_BASE_URL}/api/v2/channels/teams/<instance-id>/webhook`
# for each tenant.
#
# Per-request timeout (ms) for AAD token acquisition + Bot Framework REST
# calls. Bounds outbound `sendActivity` and `acquireAccessToken` via
# AbortSignal.timeout — a hung Microsoft endpoint will reject with AbortError
# instead of stalling. Default 15000.
# TEAMS_REQUEST_TIMEOUT_MS=15000
#
# Cap (bytes) on inbound attachment downloads. Wired into `createDownloadGuard`
# at connect-time. Decoupled from the outbound 4 MiB cap (`maxFileSize`) since
# inbound files may come from OneDrive and be much larger. Default 104857600
# (100 MiB).
# TEAMS_DOWNLOAD_MAX_BYTES=104857600
#
# Note: `TEAMS_DEFAULT_SERVICE_URL` is intentionally NOT supported. The plugin
# captures `serviceUrl` from each inbound activity per conversation (Bot
# Framework "trust on first use" — see `serviceUrls` map in plugin.ts).
# Cold-start proactive sends without prior inbound are not in v1 scope.
#
# Per-instance credentials (set on `InstanceConfig.config`, not env):
#   microsoftAppId         — Azure Bot registration App ID (GUID)
#   microsoftAppPassword   — Bot client secret
#   microsoftAppType       — 'MultiTenant' | 'SingleTenant' | 'UserAssignedMSI'
#   microsoftAppTenantId   — required when appType is 'SingleTenant' or MSI
#   serviceUrl             — captured from the first inbound activity per tenant
