{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "topo": {
      "dependsOn": ["^topo"]
    },
    "test": {
      "dependsOn": ["^build", "^topo"],
      "env": ["CI", "NODE_ENV", "MINIO_INTEGRATION", "DATABASE_URL", "TEST_DATABASE_URL", "ENABLE_DB_TESTS", "OMNI_*"],
      "outputs": []
    },
    "test:guards": {
      "dependsOn": ["^build", "^topo"],
      "env": ["CI", "NODE_ENV", "MINIO_INTEGRATION", "DATABASE_URL", "TEST_DATABASE_URL", "ENABLE_DB_TESTS", "OMNI_*"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/**/*.ts"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
