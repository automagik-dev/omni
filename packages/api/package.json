{
  "name": "@omni/api",
  "version": "2.260520.7",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./app": {
      "types": "./src/app.ts",
      "default": "./src/app.ts"
    },
    "./trpc": {
      "types": "./src/trpc/index.ts",
      "default": "./src/trpc/index.ts"
    },
    "./admin": {
      "types": "./src/admin.ts",
      "default": "./src/admin.ts"
    }
  },
  "scripts": {
    "dev": "bun --watch --env-file=../../.env src/index.ts",
    "start": "bun --env-file=../../.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "fix-persons": "bun run scripts/fix-person-duplicates.ts",
    "postinstall": "node ../../scripts/ensure-libicu-symlinks.cjs"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "@hono/swagger-ui": "^0.4.1",
    "@hono/zod-validator": "^0.4.3",
    "@omni/channel-sdk": "workspace:*",
    "@omni/core": "workspace:*",
    "@omni/db": "workspace:*",
    "@omni/media-processing": "workspace:*",
    "@omni/voice-client": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.55.0",
    "@opentelemetry/instrumentation-http": "^0.55.0",
    "@opentelemetry/resources": "^1.30.0",
    "@opentelemetry/sdk-node": "^0.55.0",
    "@opentelemetry/semantic-conventions": "^1.30.0",
    "@sentry/bun": "^10.43.0",
    "@trpc/server": "^11.0.0-rc.608",
    "drizzle-orm": "^0.38.4",
    "hono": "^4.6.17",
    "lru-cache": "^11.2.6",
    "nats": "^2.29.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@omni/channel-a2a": "workspace:*",
    "@asteasolutions/zod-to-openapi": "7.3.4",
    "@types/qrcode-terminal": "^0.12.2",
    "bun-types": "^1.1.42",
    "openapi3-ts": "^4.5.0",
    "qrcode-terminal": "^0.12.0",
    "typescript": "^5.7.3"
  }
