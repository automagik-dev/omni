# Omni Admin (KHAL pack) — BFF environment.
# Copy to .env and fill in real values. .env is git-ignored; never commit secrets.
# In production these are injected by KHAL OS App Settings (OMNI_API_KEY from the vault).

# Omni API key (secret). Starts with `omni_sk_`. Injected as `x-api-key` by the BFF only.
# Never exposed to the browser or bundled into frontend code.
OMNI_API_KEY=omni_sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Base URL of the live Omni backend (no trailing slash). The BFF appends the request path.
OMNI_BASE_URL=http://192.168.139.2:8882

# Optional: BFF bind port (default 8899) and host (default 127.0.0.1).
# PORT=8899
# HOST=127.0.0.1

# Optional: comma-separated CORS origins allowed to call the BFF directly (default http://localhost:5174).
# BFF_CORS_ORIGINS=http://localhost:5174
