# @khal-os/* resolve from the Namastex Gitea registry. The auth token is NOT
# committed — it lives in your ~/.npmrc (git credential / khal auth). This app
# is intentionally OUT of omni's root workspace (its private @khal-os deps must
# not block omni's CI install); install it standalone: cd apps/khal-ui && bun install.
@khal-os:registry=https://git.namastex.io/api/packages/khal/npm/
