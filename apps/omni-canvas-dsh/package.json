{
  "name": "@automagik/omni-canvas-dsh",
  "version": "2.261023.32",
  "description": "Omni's canvases for DeepSeek Harness: the Omni Bot shows what it found as live UI in the chat, drawn from your Omni",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "omni",
    "canvas",
    "agents"
  ],
  "homepage": "https://github.com/automagik-dev/omni/tree/dev/apps/omni-canvas-dsh#readme",
  "bugs": {
    "url": "https://github.com/automagik-dev/omni/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/automagik-dev/omni.git",
    "directory": "apps/omni-canvas-dsh"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "src/host/",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --import ./test/harness-resolve.mjs --test \"test/*.test.js\"",
    "lint": "node scripts/lint.mjs",
    "harness": "bun install --cwd dev/harness --no-save --no-summary"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "peerDependencies": {
    "@automagik/omni-channels-dsh": ">=2.261019.10",
    "@automagik/omni-dsh": ">=2.261019.10",
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "external": [
        "@automagik/omni-dsh/client",
        "@automagik/omni-channels-dsh/client"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@openuidev/lang-core": "0.2.18",
    "@openuidev/react-lang": "0.2.15",
    "esbuild": "0.28.2",
    "zod": "4.6.5"
  }
}
