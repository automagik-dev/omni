# The @deepseek-ai peers come from the dsh profile that loads the plugin. Keep npm from
# installing them here: only the build tools in devDependencies belong in node_modules.
legacy-peer-deps=true
# No dependency runs a script on install. @openuidev/lang-core's postinstall reports each
# install to PostHog unless DO_NOT_TRACK is set, and Omni sends nothing to anyone. esbuild
# needs none: its binary comes from its platform package.
ignore-scripts=true
