{
  "name": "omni-v2",
  "version": "2.260803.2",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/ui"],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "turbo test",
    "verify:versions": "bun scripts/verify-versions.ts",
    "db:verify-drift": "bun scripts/verify-schema-drift.ts",
    "clean": "turbo clean && rm -rf node_modules",
    "generate:sdk": "bun scripts/generate-sdk.ts",
    "generate:sdk-python": "bun scripts/generate-sdk-python.ts",
    "generate:sdk-go": "bun scripts/generate-sdk-go.ts",
    "prepare": "husky",
    "postinstall": "node scripts/ensure-libicu-symlinks.cjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@openapitools/openapi-generator-cli": "^2.28.0",
    "bun-types": "^1.1.42",
    "husky": "^9.1.7",
    "knip": "^5.85.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  },
  "packageManager": "bun@1.1.42",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {}
}
