# syntax=docker/dockerfile:1.7
# =============================================================================
# Omni Admin UI — the Omni UI (DeepSeek Harness + Omni's plugins) as one image
# =============================================================================
# Build from the REPO ROOT (context must see package.json, apps/*-dsh and apps/automagik.*):
#
#   DOCKER_BUILDKIT=1 docker build --platform linux/arm64 \
#     -f deploy/Dockerfile.admin-ui -t omni-admin-ui:dev .
#
# The image keeps the contract the Helm chart's adminUi workload has always used:
# port 8899 (PORT), GET /health, and OMNI_BASE_URL + OMNI_API_KEY from the
# ConfigMap and Secret. The key stays on the server: the plugins call Omni
# from DSH's host process, never from the browser. What runs is DSH on loopback
# with the profile deploy/admin-ui/prepare.mjs assembles (Omni's channels and
# canvases packed from apps/*-dsh at this checkout's version; the Bot team and the
# welcome from the Automagik release apps/automagik.json pins, downloaded from its
# GitHub release and checked against the pinned integrity), behind
# deploy/admin-ui/server.mjs.
# See server.mjs for the settings and the sign-in (the launch URL in the log).
#
# Everything needed is public: no build secret is read (an `npmrc` secret
# passed by an existing pipeline is accepted and unused). The builder reaches
# github.com for the pinned Automagik tarballs, as it reaches the npm registry.
# =============================================================================

ARG NODE_VERSION=22.23.2

# ---- builder: the pinned DSH + the plugins (this checkout's, Automagik's pinned) --
FROM node:${NODE_VERSION}-bookworm-slim AS builder
WORKDIR /src
COPY package.json ./
COPY apps ./apps
COPY deploy/admin-ui ./deploy/admin-ui
RUN node deploy/admin-ui/prepare.mjs /out

# ---- runtime: non-root; server.mjs fronts DSH on PORT ------------------------
FROM node:${NODE_VERSION}-bookworm-slim AS runtime
# git and certificates for what Bots run (clones, https); nothing else is added.
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates git \
  && rm -rf /var/lib/apt/lists/*
ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=8899 \
    OMNI_HOME=/data \
    HOME=/home/node \
    DO_NOT_TRACK=1
WORKDIR /app
COPY --from=builder /out/runtime ./runtime
COPY --from=builder /out/profile ./profile
COPY --from=builder /out/versions.json ./versions.json
COPY deploy/admin-ui/server.mjs ./server.mjs
# DSH's plugin manager runs pnpm (the runtime ships it) to install market plugins.
RUN ln -s /app/runtime/node_modules/pnpm/bin/pnpm.cjs /usr/local/bin/pnpm \
  && mkdir -p /data \
  && chown -R node:node /data /home/node
# `node` user (uid 1000) ships with the node image, as the chart's securityContext expects.
USER node
VOLUME /data

LABEL org.opencontainers.image.title="omni-admin-ui" \
      org.opencontainers.image.description="Omni Admin UI: the Omni UI (DeepSeek Harness + Omni's plugins) behind /health on port 8899" \
      org.opencontainers.image.source="https://github.com/automagik-dev/omni" \
      org.opencontainers.image.licenses="Apache-2.0"

EXPOSE 8899
# Health: GET /health → "ok" once DSH is up.
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||8899)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
ENTRYPOINT ["node", "server.mjs"]
